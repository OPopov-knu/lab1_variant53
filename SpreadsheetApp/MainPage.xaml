<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SpreadsheetApp"
             x:Class="SpreadsheetApp.MainPage"
             Title="Міні-таблиця"
             BackgroundColor="{AppThemeBinding Light=#F3F7F6, Dark=#101917}">

    <ContentPage.Resources>
        <Style x:Key="SideButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#1F8A80" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="MinimumHeightRequest" Value="38" />
        </Style>
        <Style x:Key="SideCaption" TargetType="Label">
            <Setter Property="TextColor" Value="#A7E3DC" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="1.5" />
            <Setter Property="Margin" Value="4,14,0,2" />
        </Style>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#E07A3F" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,6" />
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#0F5F58, Dark=#7DD3C8}" />
            <Setter Property="BorderColor" Value="{AppThemeBinding Light=#0F5F58, Dark=#7DD3C8}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,6" />
        </Style>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="200,*">

        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Padding="14,18"
              BackgroundColor="{AppThemeBinding Light=#0F5F58, Dark=#0B3B37}">

            <VerticalStackLayout Grid.Row="0" Spacing="2">
                <Label Text="▦ Міні-таблиця" TextColor="White" FontSize="20" FontAttributes="Bold" />
                <Label Text="варіант 53" TextColor="#A7E3DC" FontSize="12" />
            </VerticalStackLayout>

            <ScrollView Grid.Row="1" Margin="0,8,0,0">
                <VerticalStackLayout Spacing="6">
                    <Label Text="ФАЙЛ" Style="{StaticResource SideCaption}" />
                    <Button Text="Новий" Clicked="OnNewClicked" Style="{StaticResource SideButton}"
                            ToolTipProperties.Text="Створити нову порожню таблицю" />
                    <Button Text="Відкрити…" Clicked="OnOpenClicked" Style="{StaticResource SideButton}"
                            ToolTipProperties.Text="Відкрити таблицю з файлу" />
                    <Button Text="Зберегти…" Clicked="OnSaveClicked" Style="{StaticResource SideButton}"
                            ToolTipProperties.Text="Зберегти таблицю у файл" />

                    <Label Text="ТАБЛИЦЯ" Style="{StaticResource SideCaption}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto" RowSpacing="6">
                        <Button Grid.Row="0" Grid.Column="0" Text="+ Рядок" Clicked="OnAddRowClicked"
                                Style="{StaticResource SideButton}" Padding="6,8"
                                ToolTipProperties.Text="Додати рядок у кінець таблиці" />
                        <Button Grid.Row="0" Grid.Column="1" Text="− Рядок" Clicked="OnRemoveRowClicked"
                                Style="{StaticResource SideButton}" Padding="6,8"
                                ToolTipProperties.Text="Видалити останній рядок" />
                        <Button Grid.Row="1" Grid.Column="0" Text="+ Стовп." Clicked="OnAddColumnClicked"
                                Style="{StaticResource SideButton}" Padding="6,8"
                                ToolTipProperties.Text="Додати стовпчик праворуч" />
                        <Button Grid.Row="1" Grid.Column="1" Text="− Стовп." Clicked="OnRemoveColumnClicked"
                                Style="{StaticResource SideButton}" Padding="6,8"
                                ToolTipProperties.Text="Видалити останній стовпчик" />
                    </Grid>

                    <Label Text="ВІДОБРАЖЕННЯ" Style="{StaticResource SideCaption}" />
                    <RadioButton x:Name="ValueModeRadio" Content="Значення" GroupName="Mode" IsChecked="True"
                                 TextColor="White" CheckedChanged="OnModeChanged" />
                    <RadioButton x:Name="ExpressionModeRadio" Content="Вираз" GroupName="Mode"
                                 TextColor="White" CheckedChanged="OnModeChanged" />
                </VerticalStackLayout>
            </ScrollView>

            <VerticalStackLayout Grid.Row="2" Spacing="6">
                <Button Text="Довідка" Clicked="OnHelpClicked" Style="{StaticResource SideButton}"
                        BackgroundColor="Transparent" BorderColor="#A7E3DC" BorderWidth="1" />
                <Button Text="Про програму" Clicked="OnAboutClicked" Style="{StaticResource SideButton}"
                        BackgroundColor="Transparent" BorderColor="#A7E3DC" BorderWidth="1" />
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" Padding="18,14" RowSpacing="10">

            <Border Grid.Row="0" Padding="12,10" StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#18262A}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                    <Border Grid.Column="0" Padding="12,0" StrokeThickness="0" MinimumWidthRequest="64"
                            BackgroundColor="#E07A3F">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Label x:Name="CellNameLabel" Text="A1" FontAttributes="Bold" TextColor="White"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <Entry Grid.Column="1" x:Name="ExpressionEntry"
                           Placeholder="Введіть вираз, напр.: mmax(A1, B1, 3) * 2 > 10"
                           FontFamily="Courier New"
                           ClearButtonVisibility="WhileEditing"
                           Completed="OnApplyClicked"
                           TextChanged="OnExpressionTextChanged" />
                    <Button Grid.Column="2" Text="✓ Застосувати" Clicked="OnApplyClicked" Style="{StaticResource AccentButton}" />
                    <Button Grid.Column="3" Text="Скасувати" Clicked="OnCancelEditClicked" Style="{StaticResource GhostButton}" />
                </Grid>
            </Border>

            <Label Grid.Row="1" x:Name="MessageLabel" FontSize="13" FontFamily="Courier New"
                   LineBreakMode="WordWrap" MinimumHeightRequest="18" Margin="6,0" />

            <Border Grid.Row="2" StrokeThickness="1" Padding="0"
                    Stroke="{AppThemeBinding Light=#B9D8D4, Dark=#2D4A47}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#14201F}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <controls:SheetView x:Name="Sheet" />
            </Border>

            <Border Grid.Row="3" Padding="12,6" StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#DCEFEC, Dark=#1C2E2C}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label x:Name="StatusLabel" FontSize="12"
                       TextColor="{AppThemeBinding Light=#0F5F58, Dark=#A7E3DC}" />
            </Border>
        </Grid>
    </Grid>
</ContentPage>
